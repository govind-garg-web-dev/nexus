# ─── Database ─────────────────────────────────────────────────────────────────
# Get this from neon.tech → New Project → Connection String
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/nexusdb?sslmode=require

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Frontend URL (for CORS)
WEB_URL=http://localhost:3000

# Cookie signing secret — generate with: openssl rand -hex 32
COOKIE_SECRET=change_this_to_a_random_32_char_secret

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_32_char_secret

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get from resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@nexus.app

# ─── SMS (MSG91) ──────────────────────────────────────────────────────────────
# Get from msg91.com
MSG91_AUTH_KEY=xxxxxxxxxxxxxxxxxxxxxx
MSG91_TEMPLATE_ID=xxxxxxxxxxxxxxxxxxxxxx

# ─── File Storage (Cloudflare R2) ─────────────────────────────────────────────
# Get from Cloudflare dashboard → R2 → API Tokens
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=nexus-uploads
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ─── Moderation ───────────────────────────────────────────────────────────────
# Get from Google Cloud Console → Perspective API
PERSPECTIVE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Frontend (Next.js public vars — prefix with NEXT_PUBLIC_) ───────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
